{
  "name": "dsh-turn-scratch",
  "version": "0.3.1",
  "type": "module",
  "description": "DSH plugin: quarantine each turn's scratch artifacts into a per-user store outside the workspace instead of deleting them",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test-glob.mjs && node test-behavior.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.1-rc.2"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2 || 0.1.2-rc.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "cleanup",
    "scratch",
    "quarantine"
  ],
  "license": "MIT"
}
